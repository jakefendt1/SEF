# Firebase web config — Project settings > Your apps > Web app.
# These are NOT secrets: Firebase web config is public by design, and access is
# controlled by firestore.rules. Do not put a service-account key in here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Server-side only (Vercel environment variables, never in a VITE_ var --
# anything VITE_-prefixed is compiled into the browser bundle).
# Used by api/submit.ts to append rows to the Google Sheet.
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_KEY=
