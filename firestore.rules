rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Who may hold data in this project. Mirrors src/lib/allowedEmails.ts --
    // if you change one, change the other. Enforced here as well as in the
    // client so it cannot be bypassed by calling Firebase directly.
    //
    // Audited 2026-07-31: every real account was already @intralox.com, so
    // isAllowlisted() is empty. Add addresses to that list (lowercase) before
    // onboarding anyone on an outside domain.
    function emailDomain() {
      return request.auth.token.email.lower().split('@')[1];
    }

    function isAllowlisted() {
      return false;
    }

    function isAllowedUser() {
      return request.auth != null
        && request.auth.token.email != null
        && (emailDomain() == 'intralox.com' || isAllowlisted());
    }

    function isOwner(uid) {
      return isAllowedUser() && request.auth.uid == uid;
    }

    // Email verification was tried (2026-10-07) and dropped: the Firebase
    // emails didn't reach Intralox inboxes. Access relies on the domain check
    // and the admin's grants.
    function isVerified() {
      return isAllowedUser();
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    // Admins: see and change everyone's access. Mirrors ADMIN_EMAILS in
    // src/lib/access.ts -- change both together.
    function isAdmin() {
      return isVerified() && myEmail() in ['jacob.fendt@intralox.com'];
    }

    // A tool's data is reachable only with that tool granted in access/{email}
    // (or as an admin). Tool ids match TOOLS in src/lib/navigation.ts.
    function hasTool(tool) {
      return isAdmin() || (
        isVerified()
        && exists(/databases/$(database)/documents/access/$(myEmail()))
        && tool in get(/databases/$(database)/documents/access/$(myEmail())).data.tools
      );
    }

    match /access/{email} {
      allow read: if isAdmin() || (isVerified() && email == myEmail());
      allow write: if isAdmin();
    }

    // Access requests: someone taps a greyed-out tile and asks for that tool;
    // the admin sees it on Manage access. One doc per person per tool, id
    // "{email}__{toolId}" (src/lib/accessRequests.ts), so asking twice
    // overwrites instead of piling up. The requester can only write their own
    // and only these fields; the admin reads all and deletes on approve/decline.
    function validRequest(id) {
      let d = request.resource.data;
      return isVerified()
        && d.keys().hasOnly(['email', 'name', 'toolId', 'note', 'requestedAt'])
        && d.email == myEmail()
        && d.toolId is string && d.toolId.size() > 0 && d.toolId.size() <= 40
        && id == myEmail() + '__' + d.toolId
        && d.name is string && d.name.size() <= 120
        && d.note is string && d.note.size() <= 500
        && d.requestedAt is number;
    }

    match /accessRequests/{id} {
      allow read: if isAdmin() || (isVerified() && resource.data.email == myEmail());
      allow create, update: if validRequest(id);
      allow delete: if isAdmin() || (isVerified() && resource.data.email == myEmail());
    }

    match /users/{uid} {
      // Profiles are written at sign-up, before the email is verified.
      allow read, write: if isOwner(uid);
      // The admin's user list in Manage access.
      allow read: if isAdmin();

      match /assessments/{assessmentId} {
        allow read, write: if isOwner(uid) && hasTool('spiral-eval');
      }

      match /roiCalculations/{calcId} {
        allow read, write: if isOwner(uid) && hasTool('aim-glide');
      }

      match /tdBulkDensityRuns/{runId} {
        allow read, write: if isOwner(uid) && hasTool('td-bulk-density');
      }

      match /onetrackBoms/{bomId} {
        allow read, write: if isOwner(uid) && hasTool('onetrack');
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
